                <mxCell id="e_air_loiter" edge="1" parent="1" source="airborne" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=0.8953;exitY=1;entryX=0.7143;entryY=0;strokeColor=#d79b00;" target="s_loiter" value="CRITICAL,&lt;br&gt;LOITER response">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_air_eland" edge="1" parent="1" source="airborne" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=0.1279;exitY=1;entryX=0.5;entryY=0;strokeColor=#b85450;" target="s_eland" value="system = EMERGENCY">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_loiter_cruise" edge="1" parent="1" source="s_loiter" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=0.3;exitY=0;entryX=0.5;entryY=1;" target="s_cruise" value="recovered (system back to DEGRADED)">
