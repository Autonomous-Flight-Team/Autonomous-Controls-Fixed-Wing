<mxfile host="drawio" pages="3">
<diagram name="1 · System State" id="goose-system-state"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value='&lt;b&gt;GOOSE – System (health) state&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style="font-size:12px"&gt;owns arming and fault classification · fault table and parameters on page 3&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell>
<mxCell id="g_ground" value="&lt;b&gt;ON GROUND · DISARMED&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;align=center;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="1100" height="280" as="geometry"/></mxCell>
<mxCell id="g_armed" value="&lt;b&gt;ARMED&lt;/b&gt; — an emergency fault in any state in here → EMERGENCY" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="1100" height="290" as="geometry"/></mxCell>
<mxCell id="s_air" value='&lt;b&gt;IN_AIR_RESET&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Rebooted airborne. Disarmed, pilot flies MANUAL, logging only&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="s_boot" value='&lt;b&gt;BOOT&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Subsystems coming online (bring-up sub-FSMs)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="s_pre" value='&lt;b&gt;PREFLIGHT&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Sensor checks, estimator convergence&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="240" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="s_fg" value='&lt;b&gt;FAULT_GROUND&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Active fault, or latched after a CRITICAL / EMERGENCY flight&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="240" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="s_stby" value='&lt;b&gt;STANDBY&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;All systems healthy, ready to arm&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="390" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="s_bench" value='&lt;b&gt;BENCH&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Motor locked, servos live. Fault injection only here&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="s_act" value='&lt;b&gt;ACTIVE&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Armed, all healthy&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="560" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="s_deg" value='&lt;b&gt;DEGRADED&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Armed, non-critical fault. Log only, no flight effect&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="560" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="s_crit" value='&lt;b&gt;CRITICAL&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Armed, failsafe required&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="720" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="s_emer" value='&lt;b&gt;EMERGENCY&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Armed, flight cannot continue safely&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="720" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="e_boot_pre" value="boot_finish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_boot" target="s_pre"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_boot_air" value="airborne at boot&lt;br&gt;(IAS &amp;gt; V_air_detect or alt &amp;gt; h_air_detect)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="s_boot" target="s_air"><mxGeometry x="0.35" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_air_fg" value="landed (latched)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="s_air" target="s_fg"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="120"/></Array></mxGeometry></mxCell>
<mxCell id="e_pre_fg" value="fault" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_pre" target="s_fg"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_boot_fg" value="boot timeout (&amp;gt; t_boot_max)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_boot" target="s_fg"><mxGeometry x="0.55" relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="335"/><mxPoint x="704" y="335"/></Array></mxGeometry></mxCell>
<mxCell id="e_fg_pre" value="cleared → re-check&lt;br&gt;(+ clear cmd if latched)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_fg" target="s_pre"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="0" y="14" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_pre_stby" value="preflight_finish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_pre" target="s_stby"><mxGeometry x="0.4" relative="1" as="geometry"><mxPoint x="-50" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_stby_pre" value="health fault&lt;br&gt;→ re-check" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_stby" target="s_pre"><mxGeometry x="-0.55" relative="1" as="geometry"><mxPoint x="45" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_stby_act" value="ARM cmd + arm OK&lt;br&gt;(home captured)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_stby" target="s_act"><mxGeometry x="0.1" relative="1" as="geometry"><mxPoint x="-55" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_stby_bench" value="bench cmd" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_stby" target="s_bench"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_bench_stby" value="exit bench" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_bench" target="s_stby"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="0" y="10" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_act_stby" value="disarm&lt;br&gt;(on ground)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_act" target="s_stby"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint x="45" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_act_deg" value="non-critical fault&lt;br&gt;or RC lost" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_act" target="s_deg"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_deg_act" value="fault fixed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_deg" target="s_act"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="0" y="12" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_act_crit" value="critical&lt;br&gt;fault" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_act" target="s_crit"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="-30" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_deg_crit" value="critical fault, or RC lost &amp;gt; t_rc&lt;br&gt;(only if RC_REQUIRED)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_deg" target="s_crit"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="672" y="660"/><mxPoint x="452" y="660"/></Array></mxGeometry></mxCell>
<mxCell id="e_crit_deg" value="recoverable AND cleared for t_hold&lt;br&gt;AND entries &amp;lt; N_crit_max" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_crit" target="s_deg"><mxGeometry x="-0.2" relative="1" as="geometry"><Array as="points"><mxPoint x="776" y="735"/></Array></mxGeometry></mxCell>
<mxCell id="e_crit_emer" value="failsafe can't hold" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_crit" target="s_emer"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_crit_fg" value="landed + disarmed (latched)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_crit" target="s_fg"><mxGeometry x="-0.55" relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="840"/><mxPoint x="1160" y="840"/><mxPoint x="1160" y="255"/></Array></mxGeometry></mxCell>
<mxCell id="e_emer_fg" value="landed + disarmed&lt;br&gt;(latched)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_emer" target="s_fg"><mxGeometry x="0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="1020" y="285"/></Array></mxGeometry></mxCell>
<mxCell id="n_rules" value="&lt;b&gt;RULES&lt;/b&gt;&lt;br&gt;&lt;b&gt;Fault class&lt;/b&gt; picks the state: Non-critical → DEGRADED · Critical → CRITICAL · Emergency → EMERGENCY. The highest active class wins.&lt;br&gt;&lt;br&gt;&lt;b&gt;RC loss&lt;/b&gt;: lost → DEGRADED; still lost after t_rc → CRITICAL, only if RC_REQUIRED.&lt;br&gt;&lt;br&gt;&lt;b&gt;Recovery&lt;/b&gt;: CRITICAL → DEGRADED only if the fault is &lt;i&gt;recoverable&lt;/i&gt;, has been cleared for t_hold, and this flight has had fewer than N_crit_max CRITICAL entries. Otherwise it stays latched until landing.&lt;br&gt;&lt;br&gt;&lt;b&gt;Debounce&lt;/b&gt;: a fault must persist for debounce_ms before it counts.&lt;br&gt;&lt;br&gt;&lt;b&gt;In-air reset&lt;/b&gt;: airborne evidence at boot → IN_AIR_RESET, never the normal ground flow. Latches FAULT_GROUND after landing.&lt;br&gt;&lt;br&gt;&lt;b&gt;Arming&lt;/b&gt;: needs STANDBY, no active faults and a GPS fix. Home position is captured at arm (RTL target).&lt;br&gt;&lt;br&gt;&lt;b&gt;Disarm&lt;/b&gt;: accepted only when the flight FSM is ON_GROUND or LANDED. An airborne disarm cmd is rejected and logged; the pilot uses MANUAL.&lt;br&gt;&lt;br&gt;&lt;b&gt;Landed signal&lt;/b&gt;: the 'landed' edges read the flight FSM's LANDED state (in IN_AIR_RESET: airspeed and groundspeed ≈ 0).&lt;br&gt;&lt;br&gt;&lt;b&gt;FAULT_GROUND latch&lt;/b&gt;: entered after a CRITICAL or EMERGENCY flight, it needs a fault clear cmd before the PREFLIGHT re-check. A preflight fault clears on its own. BOOT taking longer than t_boot_max also → FAULT_GROUND.&lt;br&gt;&lt;br&gt;&lt;b&gt;BENCH&lt;/b&gt;: ground test mode. Arming is impossible from BENCH; fault injection cmds are ignored in every other state.&lt;br&gt;&lt;br&gt;Full fault table: page 3." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=6;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1200" y="80" width="400" height="480" as="geometry"/></mxCell>
<mxCell id="n_map" value="&lt;b&gt;EFFECT ON FLIGHT FSM (page 2)&lt;/b&gt;&lt;br&gt;BOOT / PREFLIGHT / FAULT_GROUND / STANDBY / BENCH → flight held in ON_GROUND&lt;br&gt;ACTIVE, DEGRADED → flight runs normally&lt;br&gt;CRITICAL → FAILSAFE_LOITER or RTL, per the fault's response&lt;br&gt;EMERGENCY → EMERGENCY_LAND (REJECTED_TAKEOFF if on the roll)&lt;br&gt;IN_AIR_RESET → flight FSM held, no autonomous outputs (pilot in MANUAL)&lt;br&gt;MANUAL → hardware bypass, outside both FSMs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=6;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1200" y="580" width="400" height="150" as="geometry"/></mxCell>
<mxCell id="n_check" value="&lt;b&gt;PREFLIGHT CHECKLIST&lt;/b&gt; (all must pass → STANDBY)&lt;br&gt;• All subsystems online (from BOOT)&lt;br&gt;• GPS 3D fix, sats ≥ N_sat, HDOP ≤ H_max&lt;br&gt;• Estimator converged&lt;br&gt;• Battery above takeoff threshold&lt;br&gt;• RC link valid (if RC_REQUIRED)&lt;br&gt;• Airspeed zeroed and sane; baro and mag sane&lt;br&gt;• Logging OK (SD writable)&lt;br&gt;• Mission valid, or empty (then LOITER after takeoff)&lt;br&gt;• Control surfaces checked (BENCH or pilot confirm)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=6;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1200" y="750" width="400" height="180" as="geometry"/></mxCell>
<mxCell id="n_legend" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;Blue = ground flow · Green = armed, healthy&lt;br&gt;Yellow = fault, no flight effect&lt;br&gt;Orange = failsafe · Red = emergency&lt;br&gt;Purple = in-air reset path&lt;br&gt;Grey = bench test (motor locked)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=6;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1200" y="950" width="400" height="120" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram name="2 · Flight State" id="goose-flight-state"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value='&lt;b&gt;AUTOPILOT – GOOSE&lt;/b&gt; (Good Odds Of Surviving Experiments) — flight state&amp;nbsp;&amp;nbsp;&lt;font style="font-size:12px"&gt;advances only when System State allows; faults come from page 1&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1250" height="40" as="geometry"/></mxCell>
<mxCell id="g_air" value="&lt;b&gt;AIRBORNE&lt;/b&gt; — checks System State every loop. CRITICAL with an RTL response (RC, geofence, battery low) → RTL from any state in here. FAILSAFE_LOITER sits outside on purpose: RTL needs GPS." style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="370" width="1280" height="330" as="geometry"/></mxCell>
<mxCell id="s_on" value='&lt;b&gt;ON_GROUND&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Motor locked unless system = ACTIVE&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="s_roll" value='&lt;b&gt;TAKEOFF_ROLL&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Full throttle, track centerline, T/O flaps&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="110" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="s_rot" value='&lt;b&gt;ROTATE&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Pitch to takeoff attitude&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="110" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="s_landed" value='&lt;b&gt;LANDED&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Motor cut, rollout&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="s_rto" value='&lt;b&gt;REJECTED_TAKEOFF&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Cut motor, wings level, roll out&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="250" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="s_land" value='&lt;b&gt;LANDING&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Final, flare, touchdown&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="s_desc" value='&lt;b&gt;DESCENT&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Descend to pattern altitude&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="420" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="s_rtl" value='&lt;b&gt;RTL&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;To home (set at arm). Stays RTL even if fault clears&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="420" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="s_cruise" value='&lt;b&gt;CRUISE&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Mission / waypoints&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="420" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="s_climb" value='&lt;b&gt;CLIMB&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Full power, pitch for Vy, flaps up&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="420" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="s_lo" value='&lt;b&gt;LOITER&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;GPS orbit around a point (radius r, alt h)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="570" width="160" height="80" as="geometry"/></mxCell>
<mxCell id="s_eland" value='&lt;b&gt;EMERGENCY_LAND&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Best reachable site; straight ahead if low&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="780" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="s_fsl" value='&lt;b&gt;FAILSAFE_LOITER&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;GPS lost: attitude-hold circle, wait for recovery&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=20;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="780" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="e_on_roll" value="takeoff cmd AND system = ACTIVE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_on" target="s_roll"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_roll_rot" value="IAS ≥ V1&lt;br&gt;(committed)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_roll" target="s_rot"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_rot_climb" value="airborne:&lt;br&gt;AGL &amp;gt; h_min AND&lt;br&gt;climb rate &amp;gt; 0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_rot" target="s_climb"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="55" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_climb_cruise" value="target alt&lt;br&gt;reached AND&lt;br&gt;mission valid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_climb" target="s_cruise"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_cruise_rtl" value="mission done&lt;br&gt;(END_ACTION = RTL)&lt;br&gt;or CRITICAL, RTL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_cruise" target="s_rtl"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_rtl_desc" value="over&lt;br&gt;landing site" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_rtl" target="s_desc"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_desc_land" value="on final,&lt;br&gt;aligned" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_desc" target="s_land"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_land_landed" value="touchdown,&lt;br&gt;groundspeed ≈ 0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_land" target="s_landed"><mxGeometry x="0.45" relative="1" as="geometry"><mxPoint x="55" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_landed_on" value="disarm,&lt;br&gt;flush logs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_landed" target="s_on"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="40" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_goaround" value="GO-AROUND (if go-arounds &amp;lt; N_goaround_max): unstable approach / runway blocked / landing fault (if powered)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_land" target="s_climb"><mxGeometry x="-0.2" relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="670"/><mxPoint x="1320" y="670"/><mxPoint x="1320" y="450"/></Array></mxGeometry></mxCell>
<mxCell id="e_roll_rto" value="system ≥ CRITICAL&lt;br&gt;AND IAS &amp;lt; V1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="s_roll" target="s_rto"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="-55" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_rot_rto" value="no liftoff&lt;br&gt;by t_takeoff_max" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="s_rot" target="s_rto"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="280"/></Array></mxGeometry></mxCell>
<mxCell id="e_rto_on" value="stopped, disarm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="s_rto" target="s_on"><mxGeometry x="-0.4" relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="280"/><mxPoint x="240" y="155"/></Array></mxGeometry></mxCell>
<mxCell id="e_cruise_lo" value="loiter cmd / mission item /&lt;br&gt;mission done (END_ACTION = LOITER)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_cruise" target="s_lo"><mxGeometry x="-0.55" relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="586"/></Array><mxPoint x="-100" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_lo_cruise" value="resume cmd /&lt;br&gt;loiter time done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_lo" target="s_cruise"><mxGeometry x="0.5" relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="610"/></Array><mxPoint x="55" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_climb_lo" value="loiter cmd, or at target alt with no valid mission" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_climb" target="s_lo"><mxGeometry x="0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="634"/></Array></mxGeometry></mxCell>
<mxCell id="e_lo_rtl" value="RTL cmd" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_lo" target="s_rtl"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="-28" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_air_eland" value="system = EMERGENCY" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.28125;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="g_air" target="s_eland"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="60" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_air_fsl" value="CRITICAL,&lt;br&gt;LOITER response" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.921875;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="g_air" target="s_fsl"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="-55" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_fsl_eland" value="still CRITICAL after t_loiter → system escalates to EMERGENCY" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="s_fsl" target="s_eland"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_fsl_cruise" value="GPS recovered → CRUISE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="s_fsl" target="s_cruise"><mxGeometry x="-0.45" relative="1" as="geometry"><Array as="points"><mxPoint x="1350" y="810"/><mxPoint x="1350" y="395"/><mxPoint x="980" y="395"/></Array><mxPoint x="-75" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="e_eland_landed" value="touchdown,&lt;br&gt;stopped" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="s_eland" target="s_landed"><mxGeometry x="-0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="10" y="810"/><mxPoint x="10" y="280"/></Array><mxPoint x="40" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="n_manual" value="&lt;b&gt;MANUAL (hardware RC bypass)&lt;/b&gt;&lt;br&gt;Reachable from &lt;b&gt;every&lt;/b&gt; state: pilot switch or Teensy watchdog timeout flips the servo mux. The autopilot cannot block it.&lt;br&gt;Pilot re-engages autopilot → LOITER at current position (airborne; FAILSAFE_LOITER if no GPS) or ON_GROUND." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=6;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1440" y="110" width="360" height="100" as="geometry"/></mxCell>
<mxCell id="n_routing" value="&lt;b&gt;SYSTEM STATE → FLIGHT&lt;/b&gt;&lt;br&gt;ACTIVE / DEGRADED: no change&lt;br&gt;CRITICAL: → FAILSAFE_LOITER or RTL, per the fault's response (page 3)&lt;br&gt;GPS back while in FAILSAFE_LOITER: → CRUISE (then RTL if an RTL fault is still active)&lt;br&gt;Recovered while in RTL: stay in RTL; pilot can re-command the mission&lt;br&gt;EMERGENCY, airborne: → EMERGENCY_LAND&lt;br&gt;CRITICAL or EMERGENCY on the roll below V1: → REJECTED_TAKEOFF&lt;br&gt;Fault during LANDING: go-around if powered, else continue landing&lt;br&gt;Airspeed fault: RTL flown on pitch / throttle tables, no airspeed loop&lt;br&gt;Commanded LOITER is nominal (blue): faults reach it through the AIRBORNE overrides like any airborne state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=6;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1440" y="230" width="360" height="270" as="geometry"/></mxCell>
<mxCell id="n_guards" value="&lt;b&gt;GUARDS&lt;/b&gt;&lt;br&gt;Disarm cmd is rejected in every AIRBORNE state (pilot uses MANUAL).&lt;br&gt;Go-around limit: after N_goaround_max go-arounds the landing is committed; pilot can still take MANUAL.&lt;br&gt;No valid mission: CLIMB → LOITER at target altitude instead of CRUISE.&lt;br&gt;Home is captured at arm; RTL flies to it.&lt;br&gt;LANDED is the 'landed' signal the System FSM reads (page 1)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=6;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1440" y="520" width="360" height="170" as="geometry"/></mxCell>
<mxCell id="n_legend" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;Blue = nominal&lt;br&gt;Orange = failsafe (system CRITICAL); FAILSAFE_LOITER ≠ commanded LOITER&lt;br&gt;Red = abort / system EMERGENCY&lt;br&gt;Dashed border = group, not a state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=6;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1440" y="710" width="360" height="110" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram name="3 · Fault Table" id="goose-fault-table"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value='&lt;b&gt;GOOSE – Fault table&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style="font-size:12px"&gt;one row per fault; the health monitor loops over these&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell>
<mxCell id="table" value='&lt;table border="1" cellpadding="6" style="border-collapse:collapse;width:100%;font-size:11px"&gt;&lt;tr style="background:#eeeeee"&gt;&lt;th style="width:16%"&gt;Fault&lt;/th&gt;&lt;th style="width:26%"&gt;Detection&lt;/th&gt;&lt;th style="width:11%"&gt;Class&lt;/th&gt;&lt;th style="width:8%"&gt;Recoverable&lt;/th&gt;&lt;th style="width:12%"&gt;Timeout&lt;/th&gt;&lt;th style="width:27%"&gt;System → Flight response&lt;/th&gt;&lt;/tr&gt;&lt;tr style="background:#fff2cc"&gt;&lt;td&gt;Telemetry link lost&lt;/td&gt;&lt;td&gt;No GCS packets for debounce_ms&lt;/td&gt;&lt;td&gt;Non-critical&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;DEGRADED, log&lt;/td&gt;&lt;/tr&gt;&lt;tr style="background:#fff2cc"&gt;&lt;td&gt;Redundant sensor drop / disagree&lt;/td&gt;&lt;td&gt;One of N sensors invalid or out of agreement&lt;/td&gt;&lt;td&gt;Non-critical&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;DEGRADED, log&lt;/td&gt;&lt;/tr&gt;&lt;tr style="background:#fff2cc"&gt;&lt;td&gt;Barometer fault&lt;/td&gt;&lt;td&gt;No samples, stuck, or disagrees with GPS altitude&lt;/td&gt;&lt;td&gt;Non-critical&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;DEGRADED, log; GPS altitude stands in&lt;/td&gt;&lt;/tr&gt;&lt;tr style="background:#fff2cc"&gt;&lt;td&gt;Magnetometer fault&lt;/td&gt;&lt;td&gt;No samples, stuck, or disagrees with GPS course&lt;/td&gt;&lt;td&gt;Non-critical&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;DEGRADED, log; GPS course stands in&lt;/td&gt;&lt;/tr&gt;&lt;tr style="background:#fff2cc"&gt;&lt;td&gt;Logging failure&lt;/td&gt;&lt;td&gt;SD card full or write error&lt;/td&gt;&lt;td&gt;Non-critical&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;DEGRADED, report over telemetry; blocks arming on ground&lt;/td&gt;&lt;/tr&gt;&lt;tr style="background:#fff2cc"&gt;&lt;td&gt;RC link lost&lt;/td&gt;&lt;td&gt;No valid RC frames, or receiver failsafe flag&lt;/td&gt;&lt;td&gt;Non-critical → Critical&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;t_rc (only if RC_REQUIRED)&lt;/td&gt;&lt;td&gt;DEGRADED; after t_rc → CRITICAL → &lt;b&gt;RTL&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="background:#fff2cc"&gt;&lt;td&gt;Control loop overrun&lt;/td&gt;&lt;td&gt;Loop misses its deadline&lt;/td&gt;&lt;td&gt;Non-critical → Emergency&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;N_overrun_max misses in a row&lt;/td&gt;&lt;td&gt;DEGRADED, log; N_overrun_max in a row → EMERGENCY → EMERGENCY_LAND (watchdog → MANUAL if the loop stalls)&lt;/td&gt;&lt;/tr&gt;&lt;tr style="background:#ffe6cc"&gt;&lt;td&gt;GPS lost&lt;/td&gt;&lt;td&gt;No 3D fix, sats &amp;lt; N_sat, or HDOP &amp;gt; H_max&lt;/td&gt;&lt;td&gt;Critical&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;t_loiter&lt;/td&gt;&lt;td&gt;CRITICAL → &lt;b&gt;FAILSAFE_LOITER&lt;/b&gt;; still lost after t_loiter → EMERGENCY&lt;/td&gt;&lt;/tr&gt;&lt;tr style="background:#ffe6cc"&gt;&lt;td&gt;Airspeed (pitot) fault&lt;/td&gt;&lt;td&gt;Stuck or out of range, or differs from GPS groundspeed + wind estimate by &amp;gt; dV_as&lt;/td&gt;&lt;td&gt;Critical&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;CRITICAL → &lt;b&gt;RTL&lt;/b&gt; on pitch / throttle tables (no airspeed loop)&lt;/td&gt;&lt;/tr&gt;&lt;tr style="background:#ffe6cc"&gt;&lt;td&gt;Geofence breach&lt;/td&gt;&lt;td&gt;Position outside fence&lt;/td&gt;&lt;td&gt;Critical&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;CRITICAL → &lt;b&gt;RTL&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="background:#ffe6cc"&gt;&lt;td&gt;Battery low&lt;/td&gt;&lt;td&gt;Pack voltage or mAh used past return reserve&lt;/td&gt;&lt;td&gt;Critical&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;CRITICAL → &lt;b&gt;RTL&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="background:#f8cecc"&gt;&lt;td&gt;Battery critical&lt;/td&gt;&lt;td&gt;Below landing reserve&lt;/td&gt;&lt;td&gt;Emergency&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;EMERGENCY → EMERGENCY_LAND&lt;/td&gt;&lt;/tr&gt;&lt;tr style="background:#f8cecc"&gt;&lt;td&gt;IMU lost / invalid&lt;/td&gt;&lt;td&gt;No samples, or values out of range&lt;/td&gt;&lt;td&gt;Emergency&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;EMERGENCY → EMERGENCY_LAND&lt;/td&gt;&lt;/tr&gt;&lt;tr style="background:#f8cecc"&gt;&lt;td&gt;State estimator divergence&lt;/td&gt;&lt;td&gt;Innovations or covariance over limit&lt;/td&gt;&lt;td&gt;Emergency&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;EMERGENCY → EMERGENCY_LAND&lt;/td&gt;&lt;/tr&gt;&lt;tr style="background:#f8cecc"&gt;&lt;td&gt;Motor / ESC fault&lt;/td&gt;&lt;td&gt;No current or RPM response to throttle&lt;/td&gt;&lt;td&gt;Emergency&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;EMERGENCY → EMERGENCY_LAND (glide)&lt;/td&gt;&lt;/tr&gt;&lt;tr style="background:#f8cecc"&gt;&lt;td&gt;Servo / control surface fault&lt;/td&gt;&lt;td&gt;Feedback mismatch (if measured)&lt;/td&gt;&lt;td&gt;Emergency&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;EMERGENCY → EMERGENCY_LAND; pilot takeover advised&lt;/td&gt;&lt;/tr&gt;&lt;tr style="background:#e1d5e7"&gt;&lt;td&gt;In-air reset&lt;/td&gt;&lt;td&gt;At boot: IAS &amp;gt; V_air_detect, or baro alt &amp;gt; saved ground ref + h_air_detect&lt;/td&gt;&lt;td&gt;Critical (latched)&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;BOOT → &lt;b&gt;IN_AIR_RESET&lt;/b&gt;: stay disarmed, pilot flies MANUAL; FAULT_GROUND after landing&lt;/td&gt;&lt;/tr&gt;&lt;tr style="background:#f5f5f5"&gt;&lt;td&gt;Watchdog timeout / pilot switch&lt;/td&gt;&lt;td&gt;Teensy watchdog, or RC mode switch&lt;/td&gt;&lt;td&gt;(hardware)&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;MANUAL via servo mux, outside both FSMs&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;verticalAlign=top;overflow=fill;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1300" height="580" as="geometry"/></mxCell>
<mxCell id="params" value="&lt;b&gt;PARAMETERS&lt;/b&gt; (starting values, tune in flight tests)&lt;br&gt;debounce_ms = 200 ms (fault must persist before it counts)&lt;br&gt;t_rc = 3 s (RC loss before CRITICAL)&lt;br&gt;t_hold = 5 s (fault cleared before CRITICAL can recover)&lt;br&gt;t_loiter = 60 s (max FAILSAFE_LOITER waiting for recovery)&lt;br&gt;N_crit_max = 3 (CRITICAL entries per flight before it latches)&lt;br&gt;RC_REQUIRED = true (false for autonomous missions)&lt;br&gt;END_ACTION = RTL (RTL or LOITER when the mission ends)&lt;br&gt;N_goaround_max = 2 (go-arounds before the landing is committed)&lt;br&gt;N_overrun_max = 5 (missed loop deadlines in a row before EMERGENCY)&lt;br&gt;dV_as: airspeed vs GPS + wind mismatch limit, set from flight data&lt;br&gt;V_air_detect, h_air_detect: in-air reset thresholds (above taxi speed / ground noise)&lt;br&gt;t_boot_max = 30 s (BOOT longer than this → FAULT_GROUND)&lt;br&gt;V1, h_min, t_takeoff_max: takeoff thresholds, set from airframe tests&lt;br&gt;N_sat, H_max, battery reserves: set from airframe tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=6;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="640" height="270" as="geometry"/></mxCell>
<mxCell id="rules" value="&lt;b&gt;HOW THE TABLE IS USED&lt;/b&gt;&lt;br&gt;• Each loop, evaluate every row's detection and debounce.&lt;br&gt;• System state = highest class among active faults (with RC escalation and recovery rules from page 1).&lt;br&gt;• Flight response for CRITICAL = the active critical fault's response; RTL wins over FAILSAFE_LOITER if both are active, except while GPS is lost: RTL needs GPS, so hold FAILSAFE_LOITER until it returns.&lt;br&gt;• Every fault set/clear is logged with a timestamp, so DEGRADED patterns show up in post-flight review.&lt;br&gt;• Fault injection (forcing a row over serial) is accepted only in BENCH (page 1)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=6;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="700" y="670" width="640" height="270" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
</mxfile>
