                <mxCell id="e_loiter_eland" edge="1" parent="1" source="s_loiter" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;entryX=0.5;entryY=1;strokeColor=#b85450;" target="s_eland" value="still CRITICAL after t_loiter → system escalates to EMERGENCY">
                    <mxGeometry relative="1" as="geometry">
