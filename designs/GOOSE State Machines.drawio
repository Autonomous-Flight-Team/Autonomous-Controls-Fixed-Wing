    </diagram>
    <diagram name="3 · Fault Table" id="goose-fault-table">
        <mxGraphModel dx="1117" dy="655" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;" value="&lt;b&gt;GOOSE – Fault table&lt;/b&gt;  &lt;font style=&quot;font-size:12px&quot;&gt;one row per fault; the health monitor loops over these&lt;/font&gt;" vertex="1">
                    <mxGeometry height="40" width="900" x="40" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="table" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;overflow=fill;fontSize=11;" value="&lt;table border=&quot;1&quot; cellpadding=&quot;5&quot; style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot;&gt;&lt;tr style=&quot;background:#eeeeee&quot;&gt;&lt;th&gt;Fault&lt;/th&gt;&lt;th&gt;Detection&lt;/th&gt;&lt;th&gt;Class&lt;/th&gt;&lt;th&gt;Recoverable&lt;/th&gt;&lt;th&gt;Timeout&lt;/th&gt;&lt;th&gt;System → Flight response&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#fff2cc&quot;&gt;&lt;td&gt;Telemetry link lost&lt;/td&gt;&lt;td&gt;No GCS packets for debounce_ms&lt;/td&gt;&lt;td&gt;Non-critical&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;DEGRADED, log&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#fff2cc&quot;&gt;&lt;td&gt;Redundant sensor drop / disagree&lt;/td&gt;&lt;td&gt;One of N sensors invalid or out of agreement&lt;/td&gt;&lt;td&gt;Non-critical&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;DEGRADED, log&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#fff2cc&quot;&gt;&lt;td&gt;RC link lost&lt;/td&gt;&lt;td&gt;No valid RC frames, or receiver failsafe flag&lt;/td&gt;&lt;td&gt;Non-critical → Critical&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;t_rc (only if RC_REQUIRED)&lt;/td&gt;&lt;td&gt;DEGRADED; after t_rc → CRITICAL → &lt;b&gt;RTL&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffe6cc&quot;&gt;&lt;td&gt;GPS lost&lt;/td&gt;&lt;td&gt;No 3D fix, sats &amp;lt; N_sat, or HDOP &amp;gt; H_max&lt;/td&gt;&lt;td&gt;Critical&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;t_loiter&lt;/td&gt;&lt;td&gt;CRITICAL → &lt;b&gt;LOITER&lt;/b&gt;; still lost after t_loiter → EMERGENCY&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffe6cc&quot;&gt;&lt;td&gt;Geofence breach&lt;/td&gt;&lt;td&gt;Position outside fence&lt;/td&gt;&lt;td&gt;Critical&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;CRITICAL → &lt;b&gt;RTL&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffe6cc&quot;&gt;&lt;td&gt;Battery low&lt;/td&gt;&lt;td&gt;Pack voltage or mAh used past return reserve&lt;/td&gt;&lt;td&gt;Critical&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;CRITICAL → &lt;b&gt;RTL&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f8cecc&quot;&gt;&lt;td&gt;Battery critical&lt;/td&gt;&lt;td&gt;Below landing reserve&lt;/td&gt;&lt;td&gt;Emergency&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;EMERGENCY → EMERGENCY_LAND&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f8cecc&quot;&gt;&lt;td&gt;IMU lost / invalid&lt;/td&gt;&lt;td&gt;No samples, or values out of range&lt;/td&gt;&lt;td&gt;Emergency&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;EMERGENCY → EMERGENCY_LAND&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f8cecc&quot;&gt;&lt;td&gt;State estimator divergence&lt;/td&gt;&lt;td&gt;Innovations or covariance over limit&lt;/td&gt;&lt;td&gt;Emergency&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;EMERGENCY → EMERGENCY_LAND&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f8cecc&quot;&gt;&lt;td&gt;Motor / ESC fault&lt;/td&gt;&lt;td&gt;No current or RPM response to throttle&lt;/td&gt;&lt;td&gt;Emergency&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;EMERGENCY → EMERGENCY_LAND (glide)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f8cecc&quot;&gt;&lt;td&gt;Servo / control surface fault&lt;/td&gt;&lt;td&gt;Feedback mismatch (if measured)&lt;/td&gt;&lt;td&gt;Emergency&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;EMERGENCY → EMERGENCY_LAND; pilot takeover advised&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f5f5f5&quot;&gt;&lt;td&gt;Watchdog timeout / pilot switch&lt;/td&gt;&lt;td&gt;Teensy watchdog, or RC mode switch&lt;/td&gt;&lt;td&gt;(hardware)&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;MANUAL via servo mux, outside both FSMs&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
                    <mxGeometry height="500" width="1100" x="40" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="params" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=4;" value="&lt;b&gt;PARAMETERS&lt;/b&gt; (starting values, tune in flight tests)&lt;br&gt;debounce_ms = 200 ms (fault must persist before it counts)&lt;br&gt;t_rc = 3 s (RC loss before CRITICAL)&lt;br&gt;t_hold = 5 s (fault cleared before CRITICAL can recover)&lt;br&gt;t_loiter = 60 s (max LOITER waiting for recovery)&lt;br&gt;N_crit_max = 3 (CRITICAL entries per flight before it latches)&lt;br&gt;RC_REQUIRED = true (false for autonomous missions)&lt;br&gt;N_sat, H_max, battery reserves: set from airframe tests" vertex="1">
                    <mxGeometry height="150" width="520" x="40" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="rules" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=4;" value="&lt;b&gt;HOW THE TABLE IS USED&lt;/b&gt;&lt;br&gt;• Each loop, evaluate every row&#39;s detection and debounce.&lt;br&gt;• System state = highest class among active faults (with RC escalation and recovery rules from page 1).&lt;br&gt;• Flight response for CRITICAL = the active critical fault&#39;s response; RTL wins over LOITER if both are active.&lt;br&gt;• Every fault set/clear is logged with a timestamp, so DEGRADED patterns show up in post-flight review." vertex="1">
                    <mxGeometry height="150" width="550" x="590" y="450" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>