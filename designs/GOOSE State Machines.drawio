        </mxCell>
        <mxCell id="s_act" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;fontSize=12;" value="&lt;b&gt;ACTIVE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Armed, all healthy&lt;/font&gt;" vertex="1">
