                <mxCell id="e_rot_rto" edge="1" parent="1" source="s_rot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=0.25;exitY=1;entryX=1;entryY=0.5;strokeColor=#b85450;" target="s_rto" value="no liftoff&lt;br&gt;by t_max">
