          </mxGeometry>
        </mxCell>
        <mxCell id="e_stby_pre" edge="1" parent="1" source="s_stby" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" target="s_pre" value="health fault&lt;br&gt;→ re-check">
