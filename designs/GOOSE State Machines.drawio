                <mxCell id="e_rto_on" edge="1" parent="1" source="s_rto" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.5;entryX=0.75;entryY=1;strokeColor=#b85450;" target="s_on" value="stopped, disarm">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
