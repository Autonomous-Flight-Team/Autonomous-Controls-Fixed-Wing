<mxfile host="Electron" pages="3">
  <diagram name="1 · System State" id="goose-system-state">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1640" pageHeight="1100" math="0" shadow="0">
