        </mxCell>
        <mxCell id="e_stby_bench" edge="1" parent="1" source="s_stby" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" target="s_bench" value="bench cmd">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-10" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_bench_stby" edge="1" parent="1" source="s_bench" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" target="s_stby" value="exit bench">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="10" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_act_stby" edge="1" parent="1" source="s_act" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" target="s_stby" value="disarm&lt;br&gt;(on ground)">
          <mxGeometry relative="1" x="-0.1" as="geometry">
            <mxPoint x="45" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_act_deg" edge="1" parent="1" source="s_act" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" target="s_deg" value="non-critical fault&lt;br&gt;or RC lost">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-14" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_deg_act" edge="1" parent="1" source="s_deg" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" target="s_act" value="fault fixed">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="12" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_act_crit" edge="1" parent="1" source="s_act" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" target="s_crit" value="critical&lt;br&gt;fault">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-30" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_deg_crit" edge="1" parent="1" source="s_deg" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" target="s_crit" value="critical fault, or RC lost &amp;gt; t_rc&lt;br&gt;(only if RC_REQUIRED)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="672" y="660" />
              <mxPoint x="452" y="660" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_crit_deg" edge="1" parent="1" source="s_crit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;" target="s_deg" value="recoverable AND cleared for t_hold&lt;br&gt;AND entries &amp;lt; N_crit_max">
          <mxGeometry relative="1" x="-0.2" as="geometry">
            <Array as="points">
              <mxPoint x="776" y="735" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_crit_emer" edge="1" parent="1" source="s_crit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" target="s_emer" value="failsafe can&#39;t hold">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_crit_fg" edge="1" parent="1" source="s_crit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" target="s_fg" value="landed + disarmed (latched)">
          <mxGeometry relative="1" x="-0.55" as="geometry">
            <Array as="points">
              <mxPoint x="420" y="840" />
              <mxPoint x="1160" y="840" />
              <mxPoint x="1160" y="255" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_emer_fg" edge="1" parent="1" source="s_emer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" target="s_fg" value="landed + disarmed&lt;br&gt;(latched)">
          <mxGeometry relative="1" x="0.3" as="geometry">
            <Array as="points">
              <mxPoint x="1020" y="285" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="n_rules" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=6;fontSize=11;arcSize=3;" value="&lt;b&gt;RULES&lt;/b&gt;&lt;br&gt;&lt;b&gt;Fault class&lt;/b&gt; picks the state: Non-critical → DEGRADED · Critical → CRITICAL · Emergency → EMERGENCY. The highest active class wins.&lt;br&gt;&lt;br&gt;&lt;b&gt;RC loss&lt;/b&gt;: lost → DEGRADED; still lost after t_rc → CRITICAL, only if RC_REQUIRED.&lt;br&gt;&lt;br&gt;&lt;b&gt;Recovery&lt;/b&gt;: CRITICAL → DEGRADED only if the fault is &lt;i&gt;recoverable&lt;/i&gt;, has been cleared for t_hold, and this flight has had fewer than N_crit_max CRITICAL entries. Otherwise it stays latched until landing.&lt;br&gt;&lt;br&gt;&lt;b&gt;Debounce&lt;/b&gt;: a fault must persist for debounce_ms before it counts.&lt;br&gt;&lt;br&gt;&lt;b&gt;In-air reset&lt;/b&gt;: airborne evidence at boot → IN_AIR_RESET, never the normal ground flow. Latches FAULT_GROUND after landing.&lt;br&gt;&lt;br&gt;&lt;b&gt;Arming&lt;/b&gt;: needs STANDBY, no active faults and a GPS fix. Home position is captured at arm (RTL target).&lt;br&gt;&lt;br&gt;&lt;b&gt;Disarm&lt;/b&gt;: accepted only when the flight FSM is ON_GROUND or LANDED. An airborne disarm cmd is rejected and logged; the pilot uses MANUAL.&lt;br&gt;&lt;br&gt;&lt;b&gt;Landed signal&lt;/b&gt;: the &#39;landed&#39; edges read the flight FSM&#39;s LANDED state (in IN_AIR_RESET: airspeed and groundspeed ≈ 0).&lt;br&gt;&lt;br&gt;&lt;b&gt;FAULT_GROUND latch&lt;/b&gt;: entered after a CRITICAL or EMERGENCY flight, it needs a fault clear cmd before the PREFLIGHT re-check. A preflight fault clears on its own. BOOT taking longer than t_boot_max also → FAULT_GROUND.&lt;br&gt;&lt;br&gt;&lt;b&gt;BENCH&lt;/b&gt;: ground test mode. Arming is impossible from BENCH; fault injection cmds are ignored in every other state.&lt;br&gt;&lt;br&gt;Full fault table: page 3." vertex="1">
          <mxGeometry height="480" width="400" x="1200" y="80" as="geometry" />
        </mxCell>
        <mxCell id="n_map" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=6;fontSize=11;arcSize=3;" value="&lt;b&gt;EFFECT ON FLIGHT FSM (page 2)&lt;/b&gt;&lt;br&gt;BOOT / PREFLIGHT / FAULT_GROUND / STANDBY / BENCH → flight held in ON_GROUND&lt;br&gt;ACTIVE, DEGRADED → flight runs normally&lt;br&gt;CRITICAL → FAILSAFE_LOITER or RTL, per the fault&#39;s response&lt;br&gt;EMERGENCY → EMERGENCY_LAND (REJECTED_TAKEOFF if on the roll)&lt;br&gt;IN_AIR_RESET → flight FSM held, no autonomous outputs (pilot in MANUAL)&lt;br&gt;MANUAL → hardware bypass, outside both FSMs" vertex="1">
          <mxGeometry height="150" width="400" x="1200" y="580" as="geometry" />
        </mxCell>
        <mxCell id="n_check" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=6;fontSize=11;arcSize=3;" value="&lt;b&gt;PREFLIGHT CHECKLIST&lt;/b&gt; (all must pass → STANDBY)&lt;br&gt;• All subsystems online (from BOOT)&lt;br&gt;• GPS 3D fix, sats ≥ N_sat, HDOP ≤ H_max&lt;br&gt;• Estimator converged&lt;br&gt;• Battery above takeoff threshold&lt;br&gt;• RC link valid (if RC_REQUIRED)&lt;br&gt;• Airspeed zeroed and sane; baro and mag sane&lt;br&gt;• Logging OK (SD writable)&lt;br&gt;• Mission valid, or empty (then LOITER after takeoff)&lt;br&gt;• Control surfaces checked (BENCH or pilot confirm)" vertex="1">
          <mxGeometry height="180" width="400" x="1200" y="750" as="geometry" />
        </mxCell>
        <mxCell id="n_legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=6;fontSize=11;arcSize=3;" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;Blue = ground flow · Green = armed, healthy&lt;br&gt;Yellow = fault, no flight effect&lt;br&gt;Orange = failsafe · Red = emergency&lt;br&gt;Purple = in-air reset path&lt;br&gt;Grey = bench test (motor locked)" vertex="1">
          <mxGeometry height="120" width="400" x="1200" y="950" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2 · Flight State" id="goose-flight-state">
    <mxGraphModel dx="2188" dy="1228" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;" value="&lt;b&gt;AUTOPILOT – GOOSE&lt;/b&gt; (Good Odds Of Surviving Experiments) — flight state&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:12px&quot;&gt;advances only when System State allows; faults come from page 1&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="1250" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="g_air" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;arcSize=3;" value="&lt;b&gt;AIRBORNE&lt;/b&gt; — checks System State every loop. CRITICAL with an RTL response (RC, geofence, battery low) → RTL from any state in here. FAILSAFE_LOITER sits outside on purpose: RTL needs GPS." vertex="1">
          <mxGeometry height="330" width="1280" x="20" y="370" as="geometry" />
        </mxCell>
        <mxCell id="s_on" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;fontSize=12;" value="&lt;b&gt;ON_GROUND&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Motor locked unless system = ACTIVE&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="160" x="40" y="110" as="geometry" />
        </mxCell>
        <mxCell id="s_roll" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;fontSize=12;" value="&lt;b&gt;TAKEOFF_ROLL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Full throttle, track centerline, T/O flaps&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="160" x="860" y="110" as="geometry" />
        </mxCell>
        <mxCell id="s_rot" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;fontSize=12;" value="&lt;b&gt;ROTATE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Pitch to takeoff attitude&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="160" x="1120" y="110" as="geometry" />
        </mxCell>
        <mxCell id="s_landed" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;fontSize=12;" value="&lt;b&gt;LANDED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Motor cut, rollout&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="160" x="40" y="250" as="geometry" />
        </mxCell>
        <mxCell id="s_rto" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=20;fontSize=12;" value="&lt;b&gt;REJECTED_TAKEOFF&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Cut motor, wings level, roll out&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="160" x="860" y="250" as="geometry" />
        </mxCell>
        <mxCell id="s_land" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;fontSize=12;" value="&lt;b&gt;LANDING&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Final, flare, touchdown&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="160" x="40" y="420" as="geometry" />
        </mxCell>
        <mxCell id="s_desc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;fontSize=12;" value="&lt;b&gt;DESCENT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Descend to pattern altitude&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="160" x="300" y="420" as="geometry" />
        </mxCell>
        <mxCell id="s_rtl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;fontSize=12;" value="&lt;b&gt;RTL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;To home (set at arm). Stays RTL even if fault clears&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="160" x="560" y="420" as="geometry" />
        </mxCell>
        <mxCell id="s_cruise" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;fontSize=12;" value="&lt;b&gt;CRUISE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Mission / waypoints&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="160" x="860" y="420" as="geometry" />
        </mxCell>
        <mxCell id="s_climb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;fontSize=12;" value="&lt;b&gt;CLIMB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Full power, pitch for Vy, flaps up&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="160" x="1120" y="420" as="geometry" />
        </mxCell>
        <mxCell id="s_lo" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;fontSize=12;" value="&lt;b&gt;LOITER&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GPS orbit around a point (radius r, alt h)&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="160" x="560" y="570" as="geometry" />
        </mxCell>
        <mxCell id="s_eland" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=20;fontSize=12;" value="&lt;b&gt;EMERGENCY_LAND&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Best reachable site; straight ahead if low&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="160" x="300" y="780" as="geometry" />
        </mxCell>
        <mxCell id="s_fsl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=20;fontSize=12;" value="&lt;b&gt;FAILSAFE_LOITER&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GPS lost: attitude-hold circle, wait for recovery&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="160" x="1120" y="780" as="geometry" />
        </mxCell>
        <mxCell id="e_on_roll" edge="1" parent="1" source="s_on" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" target="s_roll" value="takeoff cmd AND system = ACTIVE">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_roll_rot" edge="1" parent="1" source="s_roll" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="s_rot" value="IAS ≥ V1&lt;br&gt;(committed)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_rot_climb" edge="1" parent="1" source="s_rot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="s_climb" value="airborne:&lt;br&gt;AGL &amp;gt; h_min AND&lt;br&gt;climb rate &amp;gt; 0">
