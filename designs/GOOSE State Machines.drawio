        </mxCell>
        <mxCell id="e_stby_act" edge="1" parent="1" source="s_stby" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" target="s_act" value="ARM cmd + arm OK&lt;br&gt;(home captured)">
          <mxGeometry relative="1" x="0.1" as="geometry">
            <mxPoint x="-55" as="offset" />
