                <mxCell id="e_landed_on" edge="1" parent="1" source="s_landed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" target="s_on" value="disarm,&lt;br&gt;flush logs">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_goaround" edge="1" parent="1" source="s_land" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;entryX=1;entryY=0.5;strokeColor=#b85450;" target="s_climb" value="GO-AROUND: unstable approach / runway blocked / landing fault (if powered)">
                    <mxGeometry relative="1" as="geometry">
