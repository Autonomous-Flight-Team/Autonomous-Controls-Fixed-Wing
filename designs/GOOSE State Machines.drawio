<mxfile host="65bd71144e" pages="3">
    <diagram name="1 · System State" id="goose-system-state">
        <mxGraphModel dx="1200" dy="704" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="700" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;" value="&lt;b&gt;GOOSE – System (health) state&lt;/b&gt;  &lt;font style=&quot;font-size:12px&quot;&gt;fault classes and parameters on page 3&lt;/font&gt;" vertex="1">
                    <mxGeometry height="40" width="760" x="40" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="armed" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;fontSize=11;arcSize=4;" value="&lt;b&gt;ARMED&lt;/b&gt; — emergency fault in ANY state in here → EMERGENCY" vertex="1">
                    <mxGeometry height="290" width="500" x="260" y="250" as="geometry"/>
                </mxCell>
                <mxCell id="s_boot" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=30;" value="&lt;b&gt;BOOT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Prelim state&lt;/font&gt;" vertex="1">
                    <mxGeometry height="60" width="150" x="40" y="100" as="geometry"/>
                </mxCell>
                <mxCell id="s_pre" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=30;" value="&lt;b&gt;PREFLIGHT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Boot sensors, state estimator convergence, etc.&lt;/font&gt;" vertex="1">
                    <mxGeometry height="60" width="150" x="300" y="100" as="geometry"/>
                </mxCell>
                <mxCell id="s_fg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=30;" value="&lt;b&gt;FAULT_GROUND&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;On ground, uncleared fault&lt;/font&gt;" vertex="1">
                    <mxGeometry height="60" width="150" x="560" y="100" as="geometry"/>
                </mxCell>
                <mxCell id="s_stby" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=30;" value="&lt;b&gt;STANDBY&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;All systems healthy, ready to arm&lt;/font&gt;" vertex="1">
                    <mxGeometry height="60" width="150" x="40" y="285" as="geometry"/>
                </mxCell>
                <mxCell id="s_act" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=30;" value="&lt;b&gt;ACTIVE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Armed, all healthy&lt;/font&gt;" vertex="1">
                    <mxGeometry height="60" width="150" x="300" y="285" as="geometry"/>
                </mxCell>
                <mxCell id="s_deg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=30;" value="&lt;b&gt;DEGRADED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Armed, non-critical fault. Log only, no flight effect&lt;/font&gt;" vertex="1">
                    <mxGeometry height="60" width="150" x="570" y="285" as="geometry"/>
                </mxCell>
                <mxCell id="s_crit" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=30;" value="&lt;b&gt;CRITICAL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Armed, failsafe required&lt;/font&gt;" vertex="1">
                    <mxGeometry height="60" width="150" x="300" y="460" as="geometry"/>
                </mxCell>
                <mxCell id="s_emer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=30;" value="&lt;b&gt;EMERGENCY&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Armed, flight cannot continue safely&lt;/font&gt;" vertex="1">
                    <mxGeometry height="60" width="150" x="570" y="460" as="geometry"/>
                </mxCell>
                <mxCell id="n_faults" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=4;" value="&lt;b&gt;RULES&lt;/b&gt;&lt;br&gt;&lt;b&gt;Fault class&lt;/b&gt; picks the state: Non-critical → DEGRADED · Critical → CRITICAL · Emergency → EMERGENCY. The highest active class wins.&lt;br&gt;&lt;br&gt;&lt;b&gt;RC loss&lt;/b&gt;: lost → DEGRADED; still lost after t_rc → CRITICAL, only if RC_REQUIRED.&lt;br&gt;&lt;br&gt;&lt;b&gt;Recovery&lt;/b&gt;: CRITICAL → DEGRADED only if the fault is &lt;i&gt;recoverable&lt;/i&gt;, has been cleared for t_hold, and this flight has had fewer than N_crit_max CRITICAL entries. Otherwise it stays latched until landing.&lt;br&gt;&lt;br&gt;&lt;b&gt;Debounce&lt;/b&gt;: a fault must persist for debounce_ms before it counts.&lt;br&gt;&lt;br&gt;Full table: page 3." vertex="1">
                    <mxGeometry height="300" width="320" x="890" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="n_map" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=4;" value="&lt;b&gt;EFFECT ON FLIGHT FSM (page 2)&lt;/b&gt;&lt;br&gt;BOOT / PREFLIGHT / FAULT_GROUND / STANDBY → flight held in ON_GROUND&lt;br&gt;ACTIVE, DEGRADED → flight runs normally&lt;br&gt;CRITICAL → LOITER or RTL, per the fault&#39;s response&lt;br&gt;EMERGENCY → EMERGENCY_LAND (REJECTED_TAKEOFF if on the roll)&lt;br&gt;MANUAL → hardware bypass, outside both FSMs" vertex="1">
                    <mxGeometry height="150" width="320" x="890" y="400" as="geometry"/>
                </mxCell>
                <mxCell id="e1" edge="1" parent="1" source="s_boot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="s_pre" value="boot_finish">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" edge="1" parent="1" source="s_pre" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" target="s_fg" value="fault">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p1" edge="1" parent="1" source="s_fg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" target="s_pre" value="cleared → re-check">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" edge="1" parent="1" source="s_pre" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=0.1;exitY=1;entryX=0.25;entryY=0;" target="s_stby" value="preflight_finish">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="315" y="215"/>
                            <mxPoint x="77.5" y="215"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p2" edge="1" parent="1" source="s_stby" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=0.75;exitY=0;entryX=0.3;entryY=1;" target="s_pre" value="health fault → re-check">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="152.5" y="235"/>
                            <mxPoint x="345" y="235"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e4" edge="1" parent="1" source="s_stby" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" target="s_act" value="ARM cmd&lt;br&gt;+ arm OK">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3" edge="1" parent="1" source="s_act" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" target="s_stby" value="disarm&lt;br&gt;(on ground)">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5" edge="1" parent="1" source="s_act" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" target="s_deg" value="non-critical fault&lt;br&gt;or RC lost">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e6" edge="1" parent="1" source="s_deg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" target="s_act" value="fault fixed">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e7" edge="1" parent="1" source="s_act" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="s_crit" value="critical&lt;br&gt;fault">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e8" edge="1" parent="1" source="s_deg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=0.75;exitY=1;entryX=0.8667;entryY=0;" target="s_crit" value="critical fault, or RC lost &amp;gt; t_rc (if RC_REQUIRED)">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="682.5" y="425"/>
                            <mxPoint x="430" y="425"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e12" edge="1" parent="1" source="s_crit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=0.7;exitY=0;entryX=0.25;entryY=1;" target="s_deg" value="recoverable AND cleared for t_hold&lt;br&gt;AND entries &amp;lt; N_crit_max">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="405" y="395"/>
                            <mxPoint x="607.5" y="395"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e11" edge="1" parent="1" source="s_crit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="s_emer" value="failsafe&lt;br&gt;can&#39;t hold">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4" edge="1" parent="1" source="s_crit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;entryX=1;entryY=0.25;" target="s_fg" value="landed + disarmed, fault still active">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="375" y="570"/>
                            <mxPoint x="800" y="570"/>
                            <mxPoint x="800" y="115"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p5" edge="1" parent="1" source="s_emer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=1;entryY=0.75;" target="s_fg" value="landed +&lt;br&gt;disarmed">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="780" y="490"/>
                            <mxPoint x="780" y="145"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram name="2 · Flight State" id="goose-flight-state">
        <mxGraphModel dx="2973" dy="864" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;" value="&lt;b&gt;AUTOPILOT – GOOSE&lt;/b&gt; (Good Odds Of Surviving Experiments) — flight state  &lt;font style=&quot;font-size:12px&quot;&gt;faults come from System State (page 1)&lt;/font&gt;" vertex="1">
                    <mxGeometry height="40" width="1000" x="40" y="10" as="geometry"/>
                </mxCell>
                <mxCell id="airborne" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;arcSize=6;" value="&lt;b&gt;AIRBORNE&lt;/b&gt; — checks System State every loop. CRITICAL with an RTL response (RC, geofence, battery low) → RTL from any state in here." vertex="1">
                    <mxGeometry height="150" width="860" x="230" y="390" as="geometry"/>
                </mxCell>
                <mxCell id="s_on" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" value="&lt;b&gt;ON_GROUND&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Motor locked unless system = ACTIVE&lt;/font&gt;" vertex="1">
                    <mxGeometry height="60" width="140" x="40" y="120" as="geometry"/>
                </mxCell>
                <mxCell id="s_roll" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" value="&lt;b&gt;TAKEOFF_ROLL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Full throttle, track centerline, T/O flaps&lt;/font&gt;" vertex="1">
                    <mxGeometry height="60" width="140" x="700" y="120" as="geometry"/>
                </mxCell>
                <mxCell id="s_rot" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" value="&lt;b&gt;ROTATE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Pitch to takeoff attitude&lt;/font&gt;" vertex="1">
                    <mxGeometry height="60" width="140" x="920" y="120" as="geometry"/>
                </mxCell>
                <mxCell id="s_rto" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" value="&lt;b&gt;REJECTED_TAKEOFF&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Cut motor, wings level, roll out&lt;/font&gt;" vertex="1">
                    <mxGeometry height="60" width="140" x="700" y="270" as="geometry"/>
                </mxCell>
                <mxCell id="s_landed" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" value="&lt;b&gt;LANDED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Motor cut, rollout&lt;/font&gt;" vertex="1">
                    <mxGeometry height="60" width="140" x="40" y="280" as="geometry"/>
                </mxCell>
                <mxCell id="s_climb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" value="&lt;b&gt;CLIMB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Full power, pitch for Vy, flaps up&lt;/font&gt;" vertex="1">
                    <mxGeometry height="60" width="140" x="920" y="440" as="geometry"/>
                </mxCell>
                <mxCell id="s_cruise" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" value="&lt;b&gt;CRUISE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Mission / waypoints&lt;/font&gt;" vertex="1">
                    <mxGeometry height="60" width="140" x="700" y="440" as="geometry"/>
                </mxCell>
                <mxCell id="s_rtl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" value="&lt;b&gt;RTL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Navigate home. Stays RTL even if fault clears&lt;/font&gt;" vertex="1">
                    <mxGeometry height="60" width="140" x="480" y="440" as="geometry"/>
                </mxCell>
                <mxCell id="s_desc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" value="&lt;b&gt;DESCENT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Descend to pattern altitude&lt;/font&gt;" vertex="1">
                    <mxGeometry height="60" width="140" x="260" y="440" as="geometry"/>
                </mxCell>
                <mxCell id="s_land" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" value="&lt;b&gt;LANDING&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Final, flare, touchdown&lt;/font&gt;" vertex="1">
                    <mxGeometry height="60" width="140" x="40" y="440" as="geometry"/>
                </mxCell>
                <mxCell id="s_loiter" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;arcSize=12;" value="&lt;b&gt;LOITER&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Attitude-hold orbit, wait for recovery&lt;/font&gt;" vertex="1">
                    <mxGeometry height="60" width="140" x="900" y="620" as="geometry"/>
                </mxCell>
                <mxCell id="s_eland" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=12;" value="&lt;b&gt;EMERGENCY_LAND&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Best reachable site; straight ahead if low&lt;/font&gt;" vertex="1">
                    <mxGeometry height="60" width="160" x="260" y="620" as="geometry"/>
                </mxCell>
                <mxCell id="n_manual" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=6;" value="&lt;b&gt;MANUAL (hardware RC bypass)&lt;/b&gt;&lt;br&gt;Reachable from &lt;b&gt;every&lt;/b&gt; state: pilot switch or Teensy watchdog timeout flips the servo mux. The autopilot cannot block it.&lt;br&gt;Pilot re-engages autopilot → LOITER (airborne) or ON_GROUND." vertex="1">
                    <mxGeometry height="130" width="250" x="1170" y="120" as="geometry"/>
                </mxCell>
                <mxCell id="n_routing" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=6;" value="&lt;b&gt;SYSTEM STATE → FLIGHT&lt;/b&gt;&lt;br&gt;ACTIVE / DEGRADED: no change&lt;br&gt;CRITICAL: → LOITER or RTL, per the fault&#39;s response (page 3)&lt;br&gt;Recovered while in LOITER: → CRUISE&lt;br&gt;Recovered while in RTL: stay in RTL; pilot can re-command the mission&lt;br&gt;EMERGENCY, airborne: → EMERGENCY_LAND&lt;br&gt;CRITICAL or EMERGENCY on the roll below V1: → REJECTED_TAKEOFF&lt;br&gt;Fault during LANDING: go-around if powered, else continue landing" vertex="1">
                    <mxGeometry height="210" width="250" x="1170" y="280" as="geometry"/>
                </mxCell>
                <mxCell id="n_legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=6;" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;Blue = nominal&lt;br&gt;Orange = failsafe (system CRITICAL)&lt;br&gt;Red = abort / system EMERGENCY&lt;br&gt;Dashed = outside the autopilot" vertex="1">
                    <mxGeometry height="100" width="250" x="1170" y="510" as="geometry"/>
                </mxCell>
                <mxCell id="e_on_roll" edge="1" parent="1" source="s_on" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="s_roll" value="takeoff cmd AND system = ACTIVE">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_roll_rot" edge="1" parent="1" source="s_roll" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="s_rot" value="IAS ≥ V1&lt;br&gt;(committed)">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_rot_climb" edge="1" parent="1" source="s_rot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=0.75;exitY=1;entryX=0.75;entryY=0;" target="s_climb" value="airborne:&lt;br&gt;AGL &amp;gt; h_min AND&lt;br&gt;climb rate &amp;gt; 0">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_climb_cruise" edge="1" parent="1" source="s_climb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="s_cruise" value="target alt&lt;br&gt;reached">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_cruise_rtl" edge="1" parent="1" source="s_cruise" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="s_rtl" value="mission done&lt;br&gt;or CRITICAL,&lt;br&gt;RTL response">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_rtl_desc" edge="1" parent="1" source="s_rtl" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="s_desc" value="over&lt;br&gt;landing site">
