                <mxCell id="e_land_landed" edge="1" parent="1" source="s_land" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" target="s_landed" value="touchdown,&lt;br&gt;groundspeed ≈ 0">
                    <mxGeometry relative="1" as="geometry"/>
