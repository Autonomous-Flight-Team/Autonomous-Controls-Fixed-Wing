        </mxCell>
        <mxCell id="s_deg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=20;fontSize=12;" value="&lt;b&gt;DEGRADED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Armed, non-critical fault. Log only, no flight effect&lt;/font&gt;" vertex="1">
