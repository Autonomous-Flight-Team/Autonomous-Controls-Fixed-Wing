        <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;" value="&lt;b&gt;GOOSE – System (health) state&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:12px&quot;&gt;owns arming and fault classification · fault table and parameters on page 3&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="1100" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="g_ground" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;align=center;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;arcSize=3;" value="&lt;b&gt;ON GROUND · DISARMED&lt;/b&gt;" vertex="1">
          <mxGeometry height="280" width="1100" x="20" y="200" as="geometry" />
        </mxCell>
        <mxCell id="g_armed" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;arcSize=3;" value="&lt;b&gt;ARMED&lt;/b&gt; — an emergency fault in any state in here → EMERGENCY" vertex="1">
          <mxGeometry height="290" width="1100" x="20" y="520" as="geometry" />
        </mxCell>
        <mxCell id="s_air" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=20;fontSize=12;" value="&lt;b&gt;IN_AIR_RESET&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Rebooted airborne. Disarmed, pilot flies MANUAL, logging only&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="160" x="40" y="90" as="geometry" />
        </mxCell>
        <mxCell id="s_boot" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;fontSize=12;" value="&lt;b&gt;BOOT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Subsystems coming online (bring-up sub-FSMs)&lt;/font&gt;" vertex="1">
