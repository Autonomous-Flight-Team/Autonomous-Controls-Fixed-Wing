        </mxCell>
        <mxCell id="e_climb_cruise" edge="1" parent="1" source="s_climb" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="s_cruise" value="target alt&lt;br&gt;reached AND&lt;br&gt;mission valid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cruise_rtl" edge="1" parent="1" source="s_cruise" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="s_rtl" value="mission done&lt;br&gt;(END_ACTION = RTL)&lt;br&gt;or CRITICAL, RTL">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_rtl_desc" edge="1" parent="1" source="s_rtl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="s_desc" value="over&lt;br&gt;landing site">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_desc_land" edge="1" parent="1" source="s_desc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="s_land" value="on final,&lt;br&gt;aligned">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_land_landed" edge="1" parent="1" source="s_land" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="s_landed" value="touchdown,&lt;br&gt;groundspeed ≈ 0">
          <mxGeometry relative="1" x="0.45" as="geometry">
            <mxPoint x="55" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_landed_on" edge="1" parent="1" source="s_landed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="s_on" value="disarm,&lt;br&gt;flush logs">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="40" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_goaround" edge="1" parent="1" source="s_land" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="s_climb" value="GO-AROUND (if go-arounds &amp;lt; N_goaround_max): unstable approach / runway blocked / landing fault (if powered)">
          <mxGeometry relative="1" x="-0.2" as="geometry">
            <Array as="points">
              <mxPoint x="120" y="670" />
              <mxPoint x="1320" y="670" />
              <mxPoint x="1320" y="450" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_roll_rto" edge="1" parent="1" source="s_roll" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" target="s_rto" value="system ≥ CRITICAL&lt;br&gt;AND IAS &amp;lt; V1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-55" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_rot_rto" edge="1" parent="1" source="s_rot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" target="s_rto" value="no liftoff&lt;br&gt;by t_takeoff_max">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1160" y="280" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_rto_on" edge="1" parent="1" source="s_rto" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" target="s_on" value="stopped, disarm">
          <mxGeometry relative="1" x="-0.4" as="geometry">
            <Array as="points">
              <mxPoint x="240" y="280" />
              <mxPoint x="240" y="155" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_cruise_lo" edge="1" parent="1" source="s_cruise" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" target="s_lo" value="loiter cmd / mission item /&lt;br&gt;mission done (END_ACTION = LOITER)">
          <mxGeometry relative="1" x="-0.55" as="geometry">
            <mxPoint x="-100" as="offset" />
            <Array as="points">
              <mxPoint x="900" y="586" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_lo_cruise" edge="1" parent="1" source="s_lo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="s_cruise" value="resume cmd /&lt;br&gt;loiter time done">
          <mxGeometry relative="1" x="0.5" as="geometry">
            <mxPoint x="55" as="offset" />
            <Array as="points">
              <mxPoint x="940" y="610" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_climb_lo" edge="1" parent="1" source="s_climb" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" target="s_lo" value="loiter cmd, or at target alt with no valid mission">
          <mxGeometry relative="1" x="0.3" as="geometry">
            <Array as="points">
              <mxPoint x="1200" y="634" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_lo_rtl" edge="1" parent="1" source="s_lo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="s_rtl" value="RTL cmd">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-28" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_air_eland" edge="1" parent="1" source="g_air" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.28125;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" target="s_eland" value="system = EMERGENCY">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_air_fsl" edge="1" parent="1" source="g_air" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0.921875;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#d79b00;fontColor=#d79b00;" target="s_fsl" value="CRITICAL,&lt;br&gt;LOITER response">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-55" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_fsl_eland" edge="1" parent="1" source="s_fsl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" target="s_eland" value="still CRITICAL after t_loiter → system escalates to EMERGENCY">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_fsl_cruise" edge="1" parent="1" source="s_fsl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;strokeColor=#d79b00;fontColor=#d79b00;" target="s_cruise" value="GPS recovered → CRUISE">
          <mxGeometry relative="1" x="-0.45" as="geometry">
            <mxPoint x="-75" as="offset" />
            <Array as="points">
              <mxPoint x="1350" y="810" />
              <mxPoint x="1350" y="395" />
              <mxPoint x="980" y="395" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_eland_landed" edge="1" parent="1" source="s_eland" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" target="s_landed" value="touchdown,&lt;br&gt;stopped">
          <mxGeometry relative="1" x="-0.3" as="geometry">
            <mxPoint x="40" as="offset" />
            <Array as="points">
              <mxPoint x="10" y="810" />
              <mxPoint x="10" y="280" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="n_manual" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=6;fontSize=11;arcSize=3;" value="&lt;b&gt;MANUAL (hardware RC bypass)&lt;/b&gt;&lt;br&gt;Reachable from &lt;b&gt;every&lt;/b&gt; state: pilot switch or Teensy watchdog timeout flips the servo mux. The autopilot cannot block it.&lt;br&gt;Pilot re-engages autopilot → LOITER at current position (airborne; FAILSAFE_LOITER if no GPS) or ON_GROUND." vertex="1">
          <mxGeometry height="100" width="360" x="1440" y="110" as="geometry" />
        </mxCell>
        <mxCell id="n_routing" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=6;fontSize=11;arcSize=3;" value="&lt;b&gt;SYSTEM STATE → FLIGHT&lt;/b&gt;&lt;br&gt;ACTIVE / DEGRADED: no change&lt;br&gt;CRITICAL: → FAILSAFE_LOITER or RTL, per the fault&#39;s response (page 3)&lt;br&gt;GPS back while in FAILSAFE_LOITER: → CRUISE (then RTL if an RTL fault is still active)&lt;br&gt;Recovered while in RTL: stay in RTL; pilot can re-command the mission&lt;br&gt;EMERGENCY, airborne: → EMERGENCY_LAND&lt;br&gt;CRITICAL or EMERGENCY on the roll below V1: → REJECTED_TAKEOFF&lt;br&gt;Fault during LANDING: go-around if powered, else continue landing&lt;br&gt;Airspeed fault: RTL flown on pitch / throttle tables, no airspeed loop&lt;br&gt;Commanded LOITER is nominal (blue): faults reach it through the AIRBORNE overrides like any airborne state" vertex="1">
          <mxGeometry height="270" width="360" x="1440" y="230" as="geometry" />
        </mxCell>
        <mxCell id="n_guards" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=6;fontSize=11;arcSize=3;" value="&lt;b&gt;GUARDS&lt;/b&gt;&lt;br&gt;Disarm cmd is rejected in every AIRBORNE state (pilot uses MANUAL).&lt;br&gt;Go-around limit: after N_goaround_max go-arounds the landing is committed; pilot can still take MANUAL.&lt;br&gt;No valid mission: CLIMB → LOITER at target altitude instead of CRUISE.&lt;br&gt;Home is captured at arm; RTL flies to it.&lt;br&gt;LANDED is the &#39;landed&#39; signal the System FSM reads (page 1)." vertex="1">
          <mxGeometry height="170" width="360" x="1440" y="520" as="geometry" />
        </mxCell>
        <mxCell id="n_legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=6;fontSize=11;arcSize=3;" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;Blue = nominal&lt;br&gt;Orange = failsafe (system CRITICAL); FAILSAFE_LOITER ≠ commanded LOITER&lt;br&gt;Red = abort / system EMERGENCY&lt;br&gt;Dashed border = group, not a state" vertex="1">
          <mxGeometry height="110" width="360" x="1440" y="710" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3 · Fault Table" id="goose-fault-table">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1400" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;" value="&lt;b&gt;GOOSE – Fault table&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:12px&quot;&gt;one row per fault; the health monitor loops over these&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="1100" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="table" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;verticalAlign=top;overflow=fill;" value="&lt;table border=&quot;1&quot; cellpadding=&quot;6&quot; style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot;&gt;&lt;tr style=&quot;background:#eeeeee&quot;&gt;&lt;th style=&quot;width:16%&quot;&gt;Fault&lt;/th&gt;&lt;th style=&quot;width:26%&quot;&gt;Detection&lt;/th&gt;&lt;th style=&quot;width:11%&quot;&gt;Class&lt;/th&gt;&lt;th style=&quot;width:8%&quot;&gt;Recoverable&lt;/th&gt;&lt;th style=&quot;width:12%&quot;&gt;Timeout&lt;/th&gt;&lt;th style=&quot;width:27%&quot;&gt;System → Flight response&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#fff2cc&quot;&gt;&lt;td&gt;Telemetry link lost&lt;/td&gt;&lt;td&gt;No GCS packets for debounce_ms&lt;/td&gt;&lt;td&gt;Non-critical&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;DEGRADED, log&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#fff2cc&quot;&gt;&lt;td&gt;Redundant sensor drop / disagree&lt;/td&gt;&lt;td&gt;One of N sensors invalid or out of agreement&lt;/td&gt;&lt;td&gt;Non-critical&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;DEGRADED, log&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#fff2cc&quot;&gt;&lt;td&gt;Barometer fault&lt;/td&gt;&lt;td&gt;No samples, stuck, or disagrees with GPS altitude&lt;/td&gt;&lt;td&gt;Non-critical&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;DEGRADED, log; GPS altitude stands in&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#fff2cc&quot;&gt;&lt;td&gt;Magnetometer fault&lt;/td&gt;&lt;td&gt;No samples, stuck, or disagrees with GPS course&lt;/td&gt;&lt;td&gt;Non-critical&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;DEGRADED, log; GPS course stands in&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#fff2cc&quot;&gt;&lt;td&gt;Logging failure&lt;/td&gt;&lt;td&gt;SD card full or write error&lt;/td&gt;&lt;td&gt;Non-critical&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;DEGRADED, report over telemetry; blocks arming on ground&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#fff2cc&quot;&gt;&lt;td&gt;RC link lost&lt;/td&gt;&lt;td&gt;No valid RC frames, or receiver failsafe flag&lt;/td&gt;&lt;td&gt;Non-critical → Critical&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;t_rc (only if RC_REQUIRED)&lt;/td&gt;&lt;td&gt;DEGRADED; after t_rc → CRITICAL → &lt;b&gt;RTL&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#fff2cc&quot;&gt;&lt;td&gt;Control loop overrun&lt;/td&gt;&lt;td&gt;Loop misses its deadline&lt;/td&gt;&lt;td&gt;Non-critical → Emergency&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;N_overrun_max misses in a row&lt;/td&gt;&lt;td&gt;DEGRADED, log; N_overrun_max in a row → EMERGENCY → EMERGENCY_LAND (watchdog → MANUAL if the loop stalls)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffe6cc&quot;&gt;&lt;td&gt;GPS lost&lt;/td&gt;&lt;td&gt;No 3D fix, sats &amp;lt; N_sat, or HDOP &amp;gt; H_max&lt;/td&gt;&lt;td&gt;Critical&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;t_loiter&lt;/td&gt;&lt;td&gt;CRITICAL → &lt;b&gt;FAILSAFE_LOITER&lt;/b&gt;; still lost after t_loiter → EMERGENCY&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffe6cc&quot;&gt;&lt;td&gt;Airspeed (pitot) fault&lt;/td&gt;&lt;td&gt;Stuck or out of range, or differs from GPS groundspeed + wind estimate by &amp;gt; dV_as&lt;/td&gt;&lt;td&gt;Critical&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;CRITICAL → &lt;b&gt;RTL&lt;/b&gt; on pitch / throttle tables (no airspeed loop)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffe6cc&quot;&gt;&lt;td&gt;Geofence breach&lt;/td&gt;&lt;td&gt;Position outside fence&lt;/td&gt;&lt;td&gt;Critical&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;CRITICAL → &lt;b&gt;RTL&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffe6cc&quot;&gt;&lt;td&gt;Battery low&lt;/td&gt;&lt;td&gt;Pack voltage or mAh used past return reserve&lt;/td&gt;&lt;td&gt;Critical&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;CRITICAL → &lt;b&gt;RTL&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f8cecc&quot;&gt;&lt;td&gt;Battery critical&lt;/td&gt;&lt;td&gt;Below landing reserve&lt;/td&gt;&lt;td&gt;Emergency&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;EMERGENCY → EMERGENCY_LAND&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f8cecc&quot;&gt;&lt;td&gt;IMU lost / invalid&lt;/td&gt;&lt;td&gt;No samples, or values out of range&lt;/td&gt;&lt;td&gt;Emergency&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;EMERGENCY → EMERGENCY_LAND&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f8cecc&quot;&gt;&lt;td&gt;State estimator divergence&lt;/td&gt;&lt;td&gt;Innovations or covariance over limit&lt;/td&gt;&lt;td&gt;Emergency&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;EMERGENCY → EMERGENCY_LAND&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f8cecc&quot;&gt;&lt;td&gt;Motor / ESC fault&lt;/td&gt;&lt;td&gt;No current or RPM response to throttle&lt;/td&gt;&lt;td&gt;Emergency&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;EMERGENCY → EMERGENCY_LAND (glide)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f8cecc&quot;&gt;&lt;td&gt;Servo / control surface fault&lt;/td&gt;&lt;td&gt;Feedback mismatch (if measured)&lt;/td&gt;&lt;td&gt;Emergency&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;EMERGENCY → EMERGENCY_LAND; pilot takeover advised&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#e1d5e7&quot;&gt;&lt;td&gt;In-air reset&lt;/td&gt;&lt;td&gt;At boot: IAS &amp;gt; V_air_detect, or baro alt &amp;gt; saved ground ref + h_air_detect&lt;/td&gt;&lt;td&gt;Critical (latched)&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;BOOT → &lt;b&gt;IN_AIR_RESET&lt;/b&gt;: stay disarmed, pilot flies MANUAL; FAULT_GROUND after landing&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f5f5f5&quot;&gt;&lt;td&gt;Watchdog timeout / pilot switch&lt;/td&gt;&lt;td&gt;Teensy watchdog, or RC mode switch&lt;/td&gt;&lt;td&gt;(hardware)&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;MANUAL via servo mux, outside both FSMs&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="580" width="1300" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="params" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=6;fontSize=11;arcSize=3;" value="&lt;b&gt;PARAMETERS&lt;/b&gt; (starting values, tune in flight tests)&lt;br&gt;debounce_ms = 200 ms (fault must persist before it counts)&lt;br&gt;t_rc = 3 s (RC loss before CRITICAL)&lt;br&gt;t_hold = 5 s (fault cleared before CRITICAL can recover)&lt;br&gt;t_loiter = 60 s (max FAILSAFE_LOITER waiting for recovery)&lt;br&gt;N_crit_max = 3 (CRITICAL entries per flight before it latches)&lt;br&gt;RC_REQUIRED = true (false for autonomous missions)&lt;br&gt;END_ACTION = RTL (RTL or LOITER when the mission ends)&lt;br&gt;N_goaround_max = 2 (go-arounds before the landing is committed)&lt;br&gt;N_overrun_max = 5 (missed loop deadlines in a row before EMERGENCY)&lt;br&gt;dV_as: airspeed vs GPS + wind mismatch limit, set from flight data&lt;br&gt;V_air_detect, h_air_detect: in-air reset thresholds (above taxi speed / ground noise)&lt;br&gt;t_boot_max = 30 s (BOOT longer than this → FAULT_GROUND)&lt;br&gt;V1, h_min, t_takeoff_max: takeoff thresholds, set from airframe tests&lt;br&gt;N_sat, H_max, battery reserves: set from airframe tests" vertex="1">
          <mxGeometry height="270" width="640" x="40" y="670" as="geometry" />
        </mxCell>
        <mxCell id="rules" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=6;fontSize=11;arcSize=3;" value="&lt;b&gt;HOW THE TABLE IS USED&lt;/b&gt;&lt;br&gt;• Each loop, evaluate every row&#39;s detection and debounce.&lt;br&gt;• System state = highest class among active faults (with RC escalation and recovery rules from page 1).&lt;br&gt;• Flight response for CRITICAL = the active critical fault&#39;s response; RTL wins over FAILSAFE_LOITER if both are active, except while GPS is lost: RTL needs GPS, so hold FAILSAFE_LOITER until it returns.&lt;br&gt;• Every fault set/clear is logged with a timestamp, so DEGRADED patterns show up in post-flight review.&lt;br&gt;• Fault injection (forcing a row over serial) is accepted only in BENCH (page 1)." vertex="1">
          <mxGeometry height="270" width="640" x="700" y="670" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
