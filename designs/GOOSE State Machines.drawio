                <mxCell id="e_roll_rto" edge="1" parent="1" source="s_roll" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#b85450;" target="s_rto" value="system ≥ CRITICAL&lt;br&gt;AND IAS &amp;lt; V1">
                    <mxGeometry relative="1" as="geometry"/>
